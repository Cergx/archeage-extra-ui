{
  "name": "archeage-extra-ui",
  "private": true,
  "scripts": {
    "start": "node scripts/startChrome.js",
    "setup:chromeForTesting": "powershell -ExecutionPolicy Bypass -File scripts/installChromeForTesting.ps1",
    "build": "npm run build:tm:prod",
    "build:tm:dev": "node build.js",
    "build:tm:prod": "node build.js --prod",
    "build:chrome": "node build.js --chrome",
    "build:chrome:prod": "node build.js --chrome --prod",
    "build:chrome:zip": "npm run build:chrome:prod && cd dist/chrome && zip -r ../../chrome-extension.zip .",
    "build:firefox": "npm run build:chrome && node scripts/buildFirefox.js",
    "build:firefox:prod": "npm run build:chrome:prod && node scripts/buildFirefox.js",
    "build:firefox:xpi": "npm run build:firefox:prod && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/packageFirefox.ps1",
    "watch": "node build.js --watch"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "sass": "^1.100.0"
  }
}
